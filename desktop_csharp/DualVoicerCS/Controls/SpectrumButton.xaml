<UserControl x:Class="DualVoicerCS.Controls.SpectrumButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="72" Height="72"
             Background="Transparent"
             Cursor="Hand">
    <Grid x:Name="RootGrid">
        <!-- Rainbow spectrum ring.
             Now ROTATES while recording (RotateTx animated by code-
             behind, 0→360 over 4 s on a forever-loop) and gets a
             subtle scale pulse layered on top via ScaleTx for
             tactile heartbeat. The ring itself stays the same SIZE
             but appears VISUALLY thinner because InnerDisc's margin
             is bigger (12 vs the original 6) — half the ring width. -->
        <Ellipse x:Name="OuterRing"
                 Fill="{StaticResource SpectrumGradient}"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ScaleTx" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="RotateTx" Angle="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Inner dark disc. The visible thickness of the rainbow
             ring equals this margin value (each side of the disc
             leaves Margin px of OuterRing showing). User asked for
             "rainbow width half" — the previous build went the
             wrong way (margin 6 → 12 made the ring DOUBLE thick by
             shrinking the disc). Setting margin to 3 gives a ring
             that's exactly half the original 6 px thickness:
             a clean thin spectrum halo around a roomy mic disc. -->
        <Ellipse x:Name="InnerDisc"
                 Fill="#FF1A1B40"
                 Margin="3"/>

        <!-- VOICE-ACTIVITY PULSE.
             A red ellipse sitting INSIDE the dark disc, behind the
             mic glyph. While recording its opacity + scale animate
             continuously (0.0 ↔ 0.7 opacity, 0.55 ↔ 0.95 scale at
             450 ms half-period) to feel like a heartbeat synced
             with speech. User asked for a red indicator INSIDE the
             round part, not the original outer halo that washed
             out the surrounding buttons.
             Future enhancement: drive the amplitude from RMS so it
             literally pulses with the user's voice volume — wiring
             requires plumbing audio-level events from
             AudioCaptureService through to the button. -->
        <Ellipse x:Name="VoicePulse"
                 Margin="18"
                 Fill="#FFFF2020"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseTx" ScaleX="0.55" ScaleY="0.55"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Mic glyph stays centred on top. IsHitTestVisible=False
             so clicks bubble straight to the UserControl handler. -->
        <TextBlock x:Name="MicGlyph"
                   Text="&#xE720;"
                   FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                   FontSize="26"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>

        <!-- Small label badge at bottom-right (BN / EN). -->
        <Border x:Name="LabelBadge"
                Background="#FF1A1B40"
                CornerRadius="6"
                Padding="4,1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,4,4"
                IsHitTestVisible="False">
            <TextBlock x:Name="LabelText"
                       Text="BN"
                       Foreground="White"
                       FontSize="9"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
