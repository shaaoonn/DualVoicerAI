<Window x:Class="DualVoicerCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DualVoicerCS.Controls"
        Title="Dual Voicer CS"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnDragHandle"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Outer chrome — rounded rectangle widget body with a soft
         shadow so it floats above the desktop. Background is a
         vertical gradient matching the Python widget's purple/dark
         blue colorway.
         User asked for HALF the original padding (was 12,10; now
         6,5) and tighter inter-column gaps so the widget reads as
         compact rather than spacious. -->
    <Border x:Name="WidgetChrome"
            Background="{StaticResource WidgetBgGradient}"
            CornerRadius="14"
            Padding="6,5"
            BorderBrush="#FF4A4680"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="14"
                              Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">

            <!-- Bengali column -->
            <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                <ctrl:SpectrumButton x:Name="BtnBengali"
                                     Label="BN"
                                     Width="72" Height="72"
                                     Click="OnBengaliClicked"/>
                <Button x:Name="ArrowBengali"
                        Content="▼"
                        Width="20" Height="12"
                        Margin="0,2,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#FFB6B3D9"
                        FontSize="8"
                        Cursor="Hand"
                        Click="OnBengaliDrawerClicked"
                        ToolTip="Choose Bengali source / mode"/>
            </StackPanel>

            <!-- English column -->
            <StackPanel Orientation="Vertical" Margin="0,0,4,0">
                <ctrl:SpectrumButton x:Name="BtnEnglish"
                                     Label="EN"
                                     Width="72" Height="72"
                                     Click="OnEnglishClicked"/>
                <Button x:Name="ArrowEnglish"
                        Content="▼"
                        Width="20" Height="12"
                        Margin="0,2,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#FFB6B3D9"
                        FontSize="8"
                        Cursor="Hand"
                        Click="OnEnglishDrawerClicked"
                        ToolTip="Choose English source / mode"/>
            </StackPanel>

            <!-- Divider -->
            <Border Width="1" Background="#33FFFFFF" Margin="3,4"/>

            <!-- Settings icon — placeholder for the PoC, just demonstrates
                 the icon-cluster layout. Compact margins to match
                 the rest of the widget chrome. -->
            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="3,0,0,0">
                <Button x:Name="BtnSettings"
                        Content="&#xE713;"
                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                        FontSize="16"
                        Width="28" Height="28"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Settings (PoC stub)"
                        Click="OnSettingsClicked"/>
                <Button x:Name="BtnClose"
                        Content="&#xE8BB;"
                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                        FontSize="12"
                        Width="28" Height="20"
                        Margin="0,2,0,0"
                        Foreground="#FFD58383"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Quit"
                        Click="OnQuitClicked"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
