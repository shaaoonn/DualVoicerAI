<Window x:Class="DualVoicerCS.Views.VoiceDrawer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Border Background="{StaticResource DrawerBg}"
            BorderBrush="{StaticResource DrawerBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="14"
                              Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <StackPanel x:Name="RowHost" Orientation="Vertical"
                    MinWidth="220" Margin="2"/>
    </Border>
</Window>
