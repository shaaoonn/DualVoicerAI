<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DualVoicerCS</RootNamespace>
    <AssemblyName>DualVoicerCS</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Publish-time only. `dotnet publish -c Release` produces one self-
       contained .exe under bin/Release/net8.0-windows/win-x64/publish/.
       Keep these out of the main PropertyGroup so `dotnet build` and
       `dotnet run` stay fast and don't drop into the win-x64 sub-RID. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microphone capture. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!--
      STT happens over HTTP via Google's free /speech-api/v2 endpoint
      (same one the Python `speech_recognition` library uses against
      the public Chromium key). No NuGet needed — just HttpClient.
      Tried Whisper.net first but the base 142 MB multilingual model
      confused Bengali script with Arabic; the user reported far
      better accuracy from Google's endpoint in the Python build
      and the same coverage of 100+ languages they were used to.
    -->
  </ItemGroup>

</Project>
