<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DualVoicerCS</RootNamespace>
    <AssemblyName>DualVoicerCS</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Publish-time only. `dotnet publish -c Release` produces one self-
       contained .exe under bin/Release/net8.0-windows/win-x64/publish/.
       Keep these out of the main PropertyGroup so `dotnet build` and
       `dotnet run` stay fast and don't drop into the win-x64 sub-RID. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local multilingual speech recognition. Whisper.net wraps
         whisper.cpp; a single multilingual ggml model handles both
         Bengali and English. We pair it with the CPU runtime — for
         CUDA acceleration the user would swap in
         Whisper.net.Runtime.Cuda. The model file (~150-500 MB
         depending on size variant) is NOT bundled — the README
         tells the user where to drop it. -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <!-- Microphone capture. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
